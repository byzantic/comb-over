.title openEMS comparison: 3-line coupler, centre to each outer line 20 dB, JLC RO4350B 0.508 mm (5 GHz), plain (#41) — as built (coupler3 layout)
# Generated from the layout: includes the feed lines the layout adds. Bends, steps and the
# coupling of the diverging feed sections near the coupled lines are not modelled.
.freq 1000000000 9000000000 801
.ref 5000000000
.substrate jlc-ro4350b-0.508
# ports at the openEMS measurement planes (the feeds shortened by 3/3/3/3/3/3 mm); the openEMS result overlays every S trace
.data em coupler3-20dB-ro4350b-openems.s6p overlay
# The side-by-side run where the lines leave the section is a coupled 3-line (K_ea, K_eb); the 90° turns are not modelled.
port o1 50
port o1b 50
port c 50
port cb 50
port o3 50
port o3b 50
cline K geom=msl W=[1.1259mm 1.0765mm 1.1259mm] S=[0.6133mm 0.6133mm]
  len 8.8688mm
  A o1_k c_k o3_k
  B o1b_k cb_k o3b_k
end
cline K_ea geom=msl model=field W=[1.0995mm 1.0748mm 1.0995mm] S=[0.6274mm 0.6274mm]
  len 0.7365mm
  A o1_s c_s o3_s
  B o1_k c_k o3_k
end
cline K_eb geom=msl model=field W=[1.0995mm 1.0748mm 1.0995mm] S=[0.6274mm 0.6274mm]
  len 0.7365mm
  A o1b_k cb_k o3b_k
  B o1b_s cb_s o3b_s
end
To1_f o1 o1_s W=1.073mm len=10.4855mm
Tc_f c c_s W=1.073mm len=2.2mm
To3_f o3 o3_s W=1.073mm len=10.4855mm
To1b_f o1b o1b_s W=1.073mm len=10.4855mm
Tcb_f cb cb_s W=1.073mm len=2.2mm
To3b_f o3b o3b_s W=1.073mm len=10.4855mm
.plot ylim=-60,0 db(S33) db(S43) db(S13) db(S23)
.plot title=Directivity_(dB) db(S13/S23)
