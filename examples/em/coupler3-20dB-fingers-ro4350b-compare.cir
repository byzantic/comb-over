.title openEMS comparison: 3-line coupler, centre to each outer line 20 dB, JLC RO4350B 0.508 mm (5 GHz), finger-loaded (#41) — as built (coupler3 layout)
# Generated from the layout: includes the feed lines the layout adds. Bends, steps and the
# coupling of the diverging feed sections near the coupled lines are not modelled.
.freq 1000000000 9000000000 801
.ref 5000000000
.substrate jlc-ro4350b-0.508
# ports at the openEMS measurement planes (the feeds shortened by 3/3/3/3/3/3 mm); the openEMS result overlays every S trace
.data em coupler3-20dB-fingers-ro4350b-openems.s6p overlay
# The side-by-side run where the lines leave the section is a coupled 3-line (K_ea, K_eb); the outer lines' 90° turns are bends (mitre=none).
port o1 50
port o1b 50
port c 50
port cb 50
port o3 50
port o3b 50
cline K geom=msl W=[0.8844mm 0.8607mm 0.8844mm] S=[0.9113mm 0.9113mm]
  fingers wf=0.13mm lf=0.5423mm p=1mm lfo=0.4761mm
  C [1.2760830e-10 -1.2474140e-11 -7.4769850e-13; -1.2474140e-11 1.3078610e-10 -1.2474140e-11; -7.4769850e-13 -1.2474140e-11 1.2760830e-10]
  L [3.1537000e-7 3.4213560e-8 9.5356230e-9; 3.4213560e-8 3.1918920e-7 3.4213560e-8; 9.5356230e-9 3.4213560e-8 3.1537000e-7]
  len 6mm
  A o1_k c_k o3_k
  B o1b_k cb_k o3b_k
end
cline K_ea geom=msl model=field W=[0.9787mm 0.9669mm 0.9787mm] S=[0.8111mm 0.8111mm]
  len 0.7365mm
  A o1_s c_s o3_s
  B o1_k c_k o3_k
end
wire o1_s o1_t_1e
bend o1_t_B1 o1_t_1e o1_t_2s W=1.073002mm mitre=none
To1_t_2 o1_t_2s o1_t_2e W=1.073002mm len=6.606648mm
bend o1_t_B2 o1_t_2e o1_t_3s W=1.073002mm mitre=none
wire o1_t_3s o1_r
wire o3_s o3_t_1e
bend o3_t_B1 o3_t_1e o3_t_2s W=1.073002mm mitre=none
To3_t_2 o3_t_2s o3_t_2e W=1.073002mm len=6.606648mm
bend o3_t_B2 o3_t_2e o3_t_3s W=1.073002mm mitre=none
wire o3_t_3s o3_r
cline K_eb geom=msl model=field W=[0.9787mm 0.9669mm 0.9787mm] S=[0.8111mm 0.8111mm]
  len 0.7365mm
  A o1b_k cb_k o3b_k
  B o1b_s cb_s o3b_s
end
wire o1b_s o1b_t_1e
bend o1b_t_B1 o1b_t_1e o1b_t_2s W=1.073002mm mitre=none
To1b_t_2 o1b_t_2s o1b_t_2e W=1.073002mm len=6.606648mm
bend o1b_t_B2 o1b_t_2e o1b_t_3s W=1.073002mm mitre=none
wire o1b_t_3s o1b_r
wire o3b_s o3b_t_1e
bend o3b_t_B1 o3b_t_1e o3b_t_2s W=1.073002mm mitre=none
To3b_t_2 o3b_t_2s o3b_t_2e W=1.073002mm len=6.606648mm
bend o3b_t_B2 o3b_t_2e o3b_t_3s W=1.073002mm mitre=none
wire o3b_t_3s o3b_r
To1_f o1 o1_r W=1.073mm len=1.6635mm
Tc_f c c_s W=1.073mm len=2.2mm
To3_f o3 o3_r W=1.073mm len=1.6635mm
To1b_f o1b o1b_r W=1.073mm len=1.6635mm
Tcb_f cb cb_s W=1.073mm len=2.2mm
To3b_f o3b o3b_r W=1.073mm len=1.6635mm
.plot ylim=-60,0 db(S33) db(S43) db(S13) db(S23)
.plot title=Directivity_(dB) db(S13/S23)
