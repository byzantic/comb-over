.title Interdigital chebyshev n=3 0.1dB, f0 = 1.5 GHz, FBW = 10 % on jlc-fr4-1.6 (synthesised geometry)
# substrate jlc-fr4-1.6: h 1.53 mm, εr 4.5, copper 34.79 µm; field-solved array
# widths 3.006 2.476 3.006 mm; gaps 2.488 2.488 mm
# line length 25.672 mm (84.454° at f0, mean modal velocity); tap 4.7331 mm from the shorted end
# shorted ends: 2 × 0.3 mm vias (253.7 pH); open ends: KJK Δl as a capacitance
# realised (lossless): centre 1.50041 GHz, −3 dB FBW 14.29 % (ideal 13.89 %), worst return loss over the central 80 % of the ripple band 16.9 dB (ideal 16.43 dB)
# insertion loss at f0 2.37 dB with the substrate's conductor and dielectric loss (modal Q 49.6, 51.6, 52.9)
# tap junctions: Hammerstad tee (as Qucs); the board layout (.layout) adds the feed lines and edge connectors
.freq 0.9G 2.1G 801
.ref 1.5G
.substrate jlc-fr4-1.6
.layout interdigital
.param th0 = 84.4542698 tune 81.9206 86.9879
.param tt = 15.57096 tune 10.9 20.24
.param wf = 2.83552mm   # tap feed width (50 ohm)
.param hw = 4.66335873   # half the feed width in degrees at f0 (the tap junction spans tt ± hw)
.param w1 = 3.00566mm tune 2.55481mm 3.45651mm
.param w2 = 2.47564mm tune 2.1043mm 2.84699mm
.param s12 = 2.48752mm tune 1.99002mm 3.1094mm
.param ext1 = 1.11566mm tune 0.334698mm 2.28132mm   # end-resonator extension (tap-loading compensation)

port t1 50
port t3 50

cline S1
  geom msl
  W [w1 w2 w1]
  S [s12 s12]
  len (tt-hw)*1deg
  A g1 r2 g3
  B ta1 x2_1 ta3
end
cline S2
  geom msl
  W [w1 w2 w1]
  S [s12 s12]
  len (2*hw)*1deg
  A - x2_1 -
  B - x2_2 -
end
cline S3
  geom msl
  W [w1 w2 w1]
  S [s12 s12]
  len (th0-tt-hw)*1deg
  A tb1 x2_2 tb3
  B r1 g2 r3
end
tee TJ1 ta1 tb1 t1 Wa=w1 Wb=w1 W2=wf
tee TJ3 ta3 tb3 t3 Wa=w1 Wb=w1 W2=wf
via V1 g1 d=0.3mm n=2
via V2 g2 d=0.3mm n=2
via V3 g3 d=0.3mm n=2
T1_ext r1 - W=w1 len=ext1   # end-resonator extension beyond the array
Coe1 r1 0 0.0738494p   # open-end fringing (Δl of a 3.006 mm line)
Coe2 r2 0 0.0730978p   # open-end fringing (Δl of a 2.476 mm line)
T3_ext r3 - W=w1 len=ext1   # end-resonator extension beyond the array
Coe3 r3 0 0.0738494p   # open-end fringing (Δl of a 3.006 mm line)

.goal db(S11) < -16.43 1429873800 1573873800
.goal db(S21) < -3 900000000 1396313200   # −3 dB band at most 3 % wider than ideal
.goal db(S21) < -3 1610912900 2100000000
.plot ylim=-70,0 db(S11) db(S21) db(cheby(3,0.1,1500000000,0.1))
.plot gd(S21)
.smith S11
